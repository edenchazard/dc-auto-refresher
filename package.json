    "@typescript-eslint/parser": "^5.61.0",
    "astro-eslint-parser": "^1.4.0",
    "autoprefixer": "10.4.14",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-astro": "^1.6.0",
    "postcss": "8.4.24",
    "prettier": "^3.0.3",
    "prettier-plugin-astro": "^0.14.1",
    "tailwindcss": "3.3.2",
    "typescript": "5.1.6"
  }
