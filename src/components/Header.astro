---
import { FontAwesomeIcon } from '@fortawesome/react-fontawesome';
import { faGithub } from '@fortawesome/free-brands-svg-icons';
import { faEgg, faMugHot, faToolbox } from '@fortawesome/free-solid-svg-icons';

interface HeaderLinkProps {
  link: string;
  title: string;
  text: string;
  icon: typeof faToolbox;
}

const links: HeaderLinkProps[] = [
  {
    link: '/dc/tools',
    title: 'More DC Tools',
    text: 'Tools',
    icon: faToolbox,
  },
  {
    link: 'https://github.com/edenchazard/dc-auto-refresher/',
    title: 'View source on Github (external link)',
    text: 'Github',
    icon: faGithub,
  },
  {
    link: 'https://ko-fi.com/dctools',
    title: 'Support the site with a ko-fi (external link)',
    text: 'Ko-fi',
    icon: faMugHot,
  },
  {
    link: 'https://dragcave.net',
    title: 'Dragcave (external link)',
    text: 'Dragcave',
    icon: faEgg,
  },
];
---

<header
  id="top"
  class="minsz:px-3 text-s"
>
  <div class="bg-slate-700 flex flex-col items-stretch flex-wrap minsz:rounded-b-sm mid-sz:flex-row mid-sz:items-center">
    <h1 class="py-2 px-3 rounded-b-sm text-center flex-1 mid-sz:text-left">FART</h1>
    <nav class="flex flex-col items-stretch flex-grow divide-slate-500 menu-big:flex-row menu-big:divide-x menu-big:divide-x-dashed">
      {links.map(({ link, title, text, icon }) => (
        <a
          href={link}
          title={title}
          class="flex-1 gap-x-2 p-2 items-center flex flex-row text-center bg-slate-600 hover:border-slate-600 hover:bg-slate-800 menu-big:flex-col"
        >
          <FontAwesomeIcon icon={icon} />
          {text}
        </a>
      ))}
    </nav>
  </div>
</header>
